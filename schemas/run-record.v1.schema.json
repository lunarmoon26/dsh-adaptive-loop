{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/run-record.v1.schema.json",
  "title": "Recursive Development Loop run record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "run_id",
    "task_id",
    "change_id",
    "started_at",
    "finished_at",
    "outcome",
    "failure",
    "context",
    "artifacts",
    "metrics",
    "evidence",
    "privacy"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/run-record.v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100,
      "pattern": "^run-[a-z0-9][a-z0-9._-]+$"
    },
    "task_id": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
    },
    "change_id": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/change_id"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "blocked",
        "aborted"
      ]
    },
    "record_stage": {
      "enum": ["checkpoint", "final"]
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "code",
            "fingerprint_extra",
            "summary",
            "evidence"
          ],
          "properties": {
            "category": {
              "enum": [
                "test_failure",
                "build_failure",
                "type_error",
                "policy_denied",
                "privacy_rejection",
                "schema_invalid",
                "capsule_drift",
                "evaluation_hard_stop",
                "runtime_error",
                "timeout",
                "budget_exceeded",
                "other"
              ]
            },
            "code": {
              "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
            },
            "fingerprint_extra": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              }
            },
            "summary": {
              "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
              }
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_set",
        "environment_snapshot",
        "tool_versions",
        "model",
        "prompt_sha256",
        "harness_sha256",
        "grader_version",
        "seeds",
        "context_policy_sha256",
        "inference_parameters"
      ],
      "properties": {
        "task_set": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
        },
        "environment_snapshot": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
        },
        "tool_versions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
              },
              "version": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              }
            }
          }
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
                },
                "version": {
                  "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
                }
              }
            }
          ]
        },
        "prompt_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
            }
          ]
        },
        "harness_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
            }
          ]
        },
        "grader_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/semver"
            }
          ]
        },
        "seeds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "context_policy_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
            }
          ]
        },
        "inference_parameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
              },
              "value": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              }
            }
          }
        },
        "harness_pins": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "uri",
              "sha256"
            ],
            "properties": {
              "surface": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "uri": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
              },
              "sha256": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
              }
            }
          }
        },
        "model_patch_sha256": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "candidate_generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "candidate_sha256",
            "start_hmr_sequence",
            "end_hmr_sequence",
            "evaluation_eligible",
            "git_tree",
            "dsh_version",
            "profile"
          ],
          "properties": {
            "candidate_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
                }
              ]
            },
            "candidate_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
                }
              ]
            },
            "start_hmr_sequence": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "end_hmr_sequence": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "evaluation_eligible": {
              "type": "boolean"
            },
            "git_tree": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "dsh_version": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/semver"
                }
              ]
            },
            "profile": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
                }
              ]
            }
          }
        }
      }
    },
    "runtime_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id_sha256",
        "manifest_sha256",
        "digest_profile",
        "evidence_uri",
        "assurance",
        "stable_for_session"
      ],
      "properties": {
        "session_id_sha256": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
        },
        "digest_profile": { "const": "rfc8785-jcs-sha256-v1" },
        "evidence_uri": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
        },
        "assurance": { "enum": ["declared", "observed", "verified"] },
        "stable_for_session": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "description"
        ],
        "properties": {
          "uri": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
          },
          "sha256": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
          },
          "description": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "tool_calls"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "contains_personal_data",
        "redactions"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "contains_personal_data": {
          "type": "boolean"
        },
        "redactions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason",
              "marker"
            ],
            "properties": {
              "path": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              },
              "reason": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
              },
              "marker": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              }
            }
          }
        }
      }
    },
    "trace": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "turn",
          "step",
          "tool",
          "outcome"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "turn": {
            "type": "integer",
            "minimum": 0
          },
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "tool": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
          },
          "outcome": {
            "enum": [
              "ok",
              "failed",
              "timeout",
              "denied",
              "unknown"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pass",
          "goal_sha256",
          "actual_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pass": {
            "type": "boolean"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "goal_sha256": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
          },
          "actual_sha256": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "gated": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "upstream"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "upstream": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "business_outcome": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "source": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "earned": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["business_outcome"],
        "properties": {
          "business_outcome": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "const": "failed" }
            }
          }
        }
      },
      "then": {
        "required": ["checks"],
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": ["pass"],
              "properties": {
                "pass": { "const": false }
              }
            }
          }
        }
      }
    }
  ]
}
