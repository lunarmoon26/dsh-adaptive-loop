{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/effect-receipt.v1.schema.json",
  "title": "Recursive Development Loop effect receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "intent_id",
    "outcome",
    "receipt_ref",
    "receipt_sha256",
    "completed_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/effect-receipt.v1.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "intent_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100,
      "pattern": "^int-[a-z0-9][a-z0-9._-]+$"
    },
    "outcome": { "enum": ["completed", "failed"] },
    "receipt_ref": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
    },
    "receipt_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
