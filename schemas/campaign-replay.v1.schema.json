{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/campaign-replay.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "campaign_id", "mode", "goal", "runtime", "grader_version", "budget", "minimum_gain", "hypotheses", "cases", "baseline", "candidates"],
  "properties": {
    "$schema": { "const": "https://recursive-dev-loop.dev/schemas/campaign-replay.v1.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "mode": { "const": "replay" },
    "goal": { "$ref": "#/$defs/text" },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "generation_sha256"],
      "properties": {
        "provider": { "const": "dsh-codex" },
        "model": { "$ref": "#/$defs/text" },
        "generation_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "grader_version": { "const": "2.0.0" },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_candidates", "max_evaluations"],
      "properties": {
        "max_candidates": { "type": "integer", "minimum": 1, "maximum": 32 },
        "max_evaluations": { "type": "integer", "minimum": 1, "maximum": 2112 }
      }
    },
    "minimum_gain": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "hypotheses": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "gap", "proxy", "mechanism", "surface", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "gap": { "$ref": "#/$defs/text" },
          "proxy": { "$ref": "#/$defs/text" },
          "mechanism": { "$ref": "#/$defs/text" },
          "surface": { "enum": ["skills", "prompt"] },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 2, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "task"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["development", "qualification"] },
          "task": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "baseline": { "$ref": "#/$defs/generation" },
    "candidates": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/generation" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "pattern": "^repo://", "maxLength": 1024 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "hypothesis_id", "artifact", "results"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "hypothesis_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "artifact": { "$ref": "#/$defs/ref" },
        "results": {
          "type": "array", "minItems": 2, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["case_id", "state", "effects"],
            "properties": {
              "case_id": { "$ref": "#/$defs/id" },
              "state": { "$ref": "#/$defs/ref" },
              "effects": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }
            }
          }
        }
      }
    }
  }
}
