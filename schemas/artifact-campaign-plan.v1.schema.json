{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/artifact-campaign-plan.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "campaign_id", "goal", "metric", "evaluation_context_sha256", "researcher_sha256", "policy_sha256", "limits", "root_artifacts"],
  "properties": {
    "$schema": { "const": "https://recursive-dev-loop.dev/schemas/artifact-campaign-plan.v1.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "goal": { "$ref": "#/$defs/summary" },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "direction"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "direction": { "enum": ["maximize", "minimize"] }
      }
    },
    "evaluation_context_sha256": { "$ref": "#/$defs/digest" },
    "researcher_sha256": { "$ref": "#/$defs/digest" },
    "policy_sha256": { "$ref": "#/$defs/digest" },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "rounds", "parallelism", "resources"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "rounds": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "parallelism": { "type": "integer", "minimum": 1, "maximum": 64 },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "root_artifacts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "maxLength": 64 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resourceUnit": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "resourceAmount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "resources": {
      "type": "object", "minProperties": 1, "maxProperties": 16,
      "propertyNames": { "$ref": "#/$defs/resourceUnit" },
      "additionalProperties": { "$ref": "#/$defs/resourceAmount" }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "kind", "compatibility_sha256", "locator", "evidence_sha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/digest" },
        "kind": { "$ref": "#/$defs/slug" },
        "compatibility_sha256": { "$ref": "#/$defs/digest" },
        "locator": { "type": "string", "pattern": "^artifact://[a-f0-9]{64}$" },
        "evidence_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "kind", "compatibility_sha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/digest" },
        "kind": { "$ref": "#/$defs/slug" },
        "compatibility_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
