{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/cluster-record.v1.schema.json",
  "title": "Recursive Development Loop failure cluster record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "cluster_id",
    "created_at",
    "evaluator",
    "tier",
    "fingerprint",
    "members",
    "representative",
    "member_count",
    "summary"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/cluster-record.v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "cluster_id": {
      "type": "string",
      "minLength": 9,
      "maxLength": 100,
      "pattern": "^clu-[a-z0-9][a-z0-9._-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluator": {
      "const": "rdl-deterministic-clustering-v1"
    },
    "tier": {
      "const": "fingerprint"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "code",
        "signature"
      ],
      "properties": {
        "category": {
          "enum": [
            "test_failure",
            "build_failure",
            "type_error",
            "policy_denied",
            "privacy_rejection",
            "schema_invalid",
            "capsule_drift",
            "evaluation_hard_stop",
            "runtime_error",
            "timeout",
              "budget_exceeded",
              "business_failure",
              "other"
          ]
        },
        "code": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
        },
        "signature": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "record_uri",
          "sha256"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "pattern": "^run-[a-z0-9][a-z0-9._-]+$"
          },
          "record_uri": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
          },
          "sha256": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "representative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "record_uri",
        "sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 100,
          "pattern": "^run-[a-z0-9][a-z0-9._-]+$"
        },
        "record_uri": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
        },
        "sha256": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "member_count": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  }
}
