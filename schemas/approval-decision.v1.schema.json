{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/approval-decision.v1.schema.json",
  "title": "Recursive Development Loop human approval decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "decision_id",
    "request_id",
    "action",
    "scope",
    "decision",
    "reviewer",
    "decided_at",
    "expires_at",
    "rationale",
    "evidence",
    "candidate_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/approval-decision.v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_id": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/decision_id"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9][a-z0-9._-]+$",
      "maxLength": 100
    },
    "action": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sensitive_action"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "sha256"],
      "properties": {
        "kind": {
          "enum": ["artifact", "configuration", "data_transfer", "plugin", "proposal"]
        },
        "value": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
        },
        "sha256": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "decision": {
      "enum": ["approved", "rejected"]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "human" },
        "id": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
        }
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
      }
    },
    "candidate_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "action": { "const": "apply_optimization_candidate" }
        },
        "required": ["action"]
      },
      "then": {
        "type": "object",
        "properties": {
          "candidate_sha256": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ]
}
