{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/live-operation.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "operation", "plan_sha256", "request_sha256", "generation", "phase", "status", "response", "response_sha256", "usage", "error"],
  "properties": {
    "$schema": { "const": "https://recursive-dev-loop.dev/schemas/live-operation.v1.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "operation": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,127}$" },
    "plan_sha256": { "$ref": "live-plan.v1.schema.json#/$defs/digest" },
    "request_sha256": { "$ref": "live-plan.v1.schema.json#/$defs/digest" },
    "generation": { "$ref": "live-plan.v1.schema.json#/$defs/digest" },
    "phase": { "enum": ["task", "proposal"] },
    "status": { "enum": ["reserved", "succeeded", "failed"] },
    "response": { "type": ["object", "null"] },
    "response_sha256": { "anyOf": [{ "$ref": "live-plan.v1.schema.json#/$defs/digest" }, { "type": "null" }] },
    "error": { "type": ["string", "null"], "maxLength": 128 },
    "usage": { "anyOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 }, "cache_write_tokens": { "type": "integer", "minimum": 0 }
      }
    }] }
  }
}
