{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/stored-feedback-record.v1.schema.json",
  "title": "Recursive Development Loop stored feedback envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "storage_version",
    "record_id",
    "ingested_at",
    "source",
    "feedback_sha256",
    "privacy_scan",
    "feedback"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/stored-feedback-record.v1.schema.json"
    },
    "storage_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/feedback_id"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_path", "sha256"],
      "properties": {
        "display_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "feedback_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "privacy_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset_version", "pii_ruleset_version", "status", "scanned_at", "matched_rules"],
      "properties": {
        "ruleset_version": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
        },
        "pii_ruleset_version": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
        },
        "status": {
          "const": "passed"
        },
        "scanned_at": {
          "type": "string",
          "format": "date-time"
        },
        "matched_rules": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "feedback": {
      "$ref": "https://recursive-dev-loop.dev/schemas/feedback-log.v1.schema.json"
    }
  }
}
