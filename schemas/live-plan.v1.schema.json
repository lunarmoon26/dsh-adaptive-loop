{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/live-plan.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "campaign_id", "workspace", "runtime_sha256", "credential_store", "model", "goal", "response_contract", "base_prompt", "cases", "limits", "minimum_gain"],
  "properties": {
    "$schema": { "const": "https://recursive-dev-loop.dev/schemas/live-plan.v1.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "campaign_id": { "$ref": "#/$defs/id" },
    "workspace": { "$ref": "#/$defs/text" },
    "credential_store": { "$ref": "#/$defs/text" },
    "runtime_sha256": { "$ref": "#/$defs/digest" },
    "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,100}$" },
    "goal": { "$ref": "#/$defs/text" },
    "response_contract": { "$ref": "#/$defs/text" },
    "base_prompt": { "$ref": "#/$defs/text" },
    "minimum_gain": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "exploration_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "max_parallelism", "max_rounds"],
      "properties": {
        "strategy": { "enum": ["breadth_first", "development_first"] },
        "max_parallelism": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "cases": {
      "type": "array", "minItems": 3, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "input", "expected"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["development", "qualification", "canary"] },
          "input": { "$ref": "#/$defs/text" },
          "expected": { "type": "object", "minProperties": 1, "maxProperties": 32 }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["candidates", "requests", "timeout_ms", "output_tokens", "output_bytes", "prompt_bytes"],
      "properties": {
        "candidates": { "type": "integer", "minimum": 1, "maximum": 8 },
        "requests": { "type": "integer", "minimum": 1, "maximum": 512 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "output_tokens": { "type": "integer", "minimum": 128, "maximum": 8192 },
        "output_bytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "prompt_bytes": { "type": "integer", "minimum": 128, "maximum": 16384 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
