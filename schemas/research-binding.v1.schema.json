{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/research-binding.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "campaign_id", "node_id", "mechanism_sha256", "task_contract_uri", "task_harness_sha256", "artifacts"],
  "properties": {
    "$schema": { "const": "https://recursive-dev-loop.dev/schemas/research-binding.v1.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "campaign_id": { "$ref": "#/$defs/id" }, "node_id": { "$ref": "#/$defs/id" },
    "mechanism_sha256": { "$ref": "#/$defs/digest" },
    "task_contract_uri": { "$ref": "#/$defs/uri" },
    "task_harness_sha256": { "$ref": "#/$defs/digest" },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "type": "object", "additionalProperties": false, "required": ["sha256", "uri"],
        "properties": { "sha256": { "$ref": "#/$defs/digest" }, "uri": { "$ref": "#/$defs/uri" } } }
    }
  },
  "$defs": {
    "id": { "$ref": "https://recursive-dev-loop.dev/schemas/artifact-campaign-plan.v1.schema.json#/$defs/id" },
    "digest": { "$ref": "https://recursive-dev-loop.dev/schemas/artifact-campaign-plan.v1.schema.json#/$defs/digest" },
    "uri": { "type": "string", "pattern": "^repo://[^\\\\?#%\\u0000]+$", "maxLength": 2000 }
  }
}
