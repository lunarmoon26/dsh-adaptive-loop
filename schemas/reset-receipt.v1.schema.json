{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/reset-receipt.v1.schema.json",
  "title": "DSH Adaptive Loop reset receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "reset_id",
    "action",
    "repository",
    "stores_digest",
    "removed",
    "reason",
    "actor",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/reset-receipt.v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "reset_id": {
      "type": "string",
      "pattern": "^reset-[a-z0-9][a-z0-9._-]+$",
      "maxLength": 100
    },
    "action": {
      "const": "reset"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "revision", "branch", "dirty"],
      "properties": {
        "root": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
        },
        "revision": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/git_revision" }
          ]
        },
        "branch": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "stores_digest": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_files", "outbox", "store", "runs", "clusters", "other"],
      "properties": {
        "total_files": { "type": "integer", "minimum": 0 },
        "outbox": { "type": "integer", "minimum": 0 },
        "store": { "type": "integer", "minimum": 0 },
        "runs": { "type": "integer", "minimum": 0 },
        "clusters": { "type": "integer", "minimum": 0 },
        "other": { "type": "integer", "minimum": 0 }
      }
    },
    "reason": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "actor": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
