{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/optimizer-candidate.v1.schema.json",
  "title": "DSH Adaptive Loop optimizer candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "candidate_id",
    "exchange_id",
    "surface",
    "target_uri",
    "base_sha256",
    "title",
    "objective",
    "statement",
    "improvements",
    "regressions",
    "edits"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/optimizer-candidate.v1.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand-[a-z0-9][a-z0-9._-]+$",
      "maxLength": 100
    },
    "exchange_id": {
      "type": "string",
      "pattern": "^opt-[a-z0-9][a-z0-9._-]+$",
      "maxLength": 100
    },
    "surface": { "const": "skills" },
    "target_uri": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
    },
    "base_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "title": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "objective": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "statement": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "improvements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "expected_delta"],
        "properties": {
          "metric": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
          },
          "expected_delta": { "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    },
    "regressions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "severity"],
        "properties": {
          "summary": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
          },
          "severity": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor", "before", "after"],
        "properties": {
          "anchor": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
          },
          "before": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "after": { "type": "string", "maxLength": 8192 }
        }
      }
    }
  }
}
