{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/seal-reveal.v1.schema.json",
  "title": "Recursive Development Loop sealed-holdout reveal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "seal_id",
    "candidate_id",
    "revealed_at",
    "holdout_cases"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/seal-reveal.v1.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "seal_id": {
      "type": "string",
      "minLength": 9,
      "maxLength": 100,
      "pattern": "^seal-[a-z0-9][a-z0-9._-]+$"
    },
    "candidate_id": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
    },
    "revealed_at": { "type": "string", "format": "date-time" },
    "holdout_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "sha256"],
        "properties": {
          "case_id": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
          },
          "sha256": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
          }
        }
      }
    }
  }
}
