{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/knowledge-capsule.v1.schema.json",
  "title": "Recursive Development Loop knowledge capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "capsule_id",
    "capsule_version",
    "title",
    "audience",
    "checked_at",
    "refresh_after",
    "sources",
    "claims",
    "retrieval_pointers",
    "limits"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/knowledge-capsule.v1.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "capsule_id": {
      "type": "string",
      "pattern": "^capsule-[a-z0-9][a-z0-9._-]+$",
      "maxLength": 100
    },
    "capsule_version": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/semver"
    },
    "title": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
    },
    "audience": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "refresh_after": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "uri", "revision", "sha256", "local_path", "required"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^src-[a-z0-9][a-z0-9._-]+$",
            "maxLength": 100
          },
          "kind": {
            "enum": ["local_file", "git_file", "url"]
          },
          "uri": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
          },
          "revision": {
            "type": ["string", "null"],
            "maxLength": 256
          },
          "sha256": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
          },
          "local_path": {
            "type": ["string", "null"],
            "maxLength": 2048
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source_ids"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^claim-[a-z0-9][a-z0-9._-]+$",
            "maxLength": 100
          },
          "text": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^src-[a-z0-9][a-z0-9._-]+$",
              "maxLength": 100
            }
          }
        }
      }
    },
    "retrieval_pointers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "uri", "source_ids"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ptr-[a-z0-9][a-z0-9._-]+$",
            "maxLength": 100
          },
          "when": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
          },
          "uri": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^src-[a-z0-9][a-z0-9._-]+$",
              "maxLength": 100
            }
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
      }
    }
  }
}
