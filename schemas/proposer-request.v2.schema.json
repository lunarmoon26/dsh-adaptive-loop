{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/proposer-request.v2.schema.json",
  "title": "Budget-bound text-only multi-provider proposer request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "endpoint", "provider", "method", "content_type", "credential_env", "headers", "budget", "limits", "body"],
  "properties": {
    "$schema": { "const": "https://recursive-dev-loop.dev/schemas/proposer-request.v2.schema.json" },
    "schema_version": { "const": "2.0.0" },
    "endpoint": { "type": "string" },
    "provider": { "enum": ["openai", "anthropic", "deepseek-official"] },
    "method": { "const": "POST" },
    "content_type": { "const": "application/json" },
    "credential_env": { "type": "string" },
    "headers": { "type": "object" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_id", "provider_limit_microusd", "reservation_microusd"],
      "properties": {
        "budget_id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$" },
        "provider_limit_microusd": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "reservation_microusd": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_bytes", "response_bytes", "timeout_ms"],
      "properties": {
        "request_bytes": { "const": 65536 },
        "response_bytes": { "const": 131072 },
        "timeout_ms": { "const": 30000 }
      }
    },
    "body": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "provider": { "const": "deepseek-official" },
        "endpoint": { "const": "https://api.deepseek.com/chat/completions" },
        "credential_env": { "const": "DEEPSEEK_API_KEY" },
        "headers": { "const": {} },
        "body": { "$ref": "proposer-request.v1.schema.json#/properties/body" }
      }
    },
    {
      "properties": {
        "provider": { "const": "openai" },
        "endpoint": { "const": "https://api.openai.com/v1/responses" },
        "credential_env": { "const": "OPENAI_API_KEY" },
        "headers": { "const": {} },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "input", "stream", "max_output_tokens", "store", "text"],
          "properties": {
            "model": { "const": "gpt-5.6-terra" },
            "input": { "$ref": "proposer-request.v1.schema.json#/properties/body/properties/messages" },
            "stream": { "const": false },
            "max_output_tokens": { "const": 2048 },
            "store": { "const": false },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": ["format"],
              "properties": { "format": { "$ref": "proposer-request.v1.schema.json#/properties/body/properties/response_format" } }
            }
          }
        }
      }
    },
    {
      "properties": {
        "provider": { "const": "anthropic" },
        "endpoint": { "const": "https://api.anthropic.com/v1/messages" },
        "credential_env": { "const": "ANTHROPIC_API_KEY" },
        "headers": { "const": { "anthropic-version": "2023-06-01" } },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "system", "messages", "stream", "max_tokens"],
          "properties": {
            "model": { "const": "claude-sonnet-5" },
            "system": { "$ref": "proposer-request.v1.schema.json#/properties/body/properties/messages/prefixItems/0/properties/content" },
            "messages": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": { "$ref": "proposer-request.v1.schema.json#/properties/body/properties/messages/prefixItems/1" }
            },
            "stream": { "const": false },
            "max_tokens": { "const": 2048 }
          }
        }
      }
    }
  ]
}
