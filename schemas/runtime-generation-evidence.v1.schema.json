{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/runtime-generation-evidence.v1.schema.json",
  "title": "Recursive Development Loop runtime generation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_sha256",
    "manifest_uri",
    "digest_profile",
    "assurance",
    "producer",
    "session_binding",
    "stable_for_session",
    "claims"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/runtime-generation-evidence.v1.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "manifest_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "manifest_uri": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
    },
    "digest_profile": { "const": "rfc8785-jcs-sha256-v1" },
    "assurance": { "enum": ["declared", "observed", "verified"] },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
        },
        "version": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
        }
      }
    },
    "session_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id_sha256", "bound_transition_sequence", "final_transition_sequence"],
      "properties": {
        "session_id_sha256": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
        },
        "bound_transition_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "final_transition_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "stable_for_session": { "type": "boolean" },
    "claims": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {
            "enum": [
              "artifact-closure",
              "effective-config",
              "launcher-composition",
              "resolver-closure",
              "session-binding"
            ]
          },
          "status": { "enum": ["passed", "failed", "unavailable"] },
          "evidence": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
            }
          }
        }
      }
    }
  }
}
