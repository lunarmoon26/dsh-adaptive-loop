{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/proposal-draft.v1.schema.json",
  "title": "Recursive Development Loop proposal draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "draft_id",
    "created_at",
    "payload_sha256",
    "model",
    "surface",
    "target_uri",
    "base_sha256",
    "title",
    "objective",
    "statement",
    "improvements",
    "regressions",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/proposal-draft.v1.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "draft_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100,
      "pattern": "^drf-[a-z0-9][a-z0-9._-]+$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "payload_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
        },
        "model": {
          "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
        }
      }
    },
    "surface": {
      "enum": [
        "prompt",
        "tool_descriptions",
        "skills",
        "memory_policy",
        "routing",
        "stop_retry_logic",
        "harness_code"
      ]
    },
    "target_uri": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/uri"
    },
    "base_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "title": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
    },
    "objective": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "statement": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
    },
    "improvements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "expected_delta"],
        "properties": {
          "metric": {
            "enum": [
              "task_success_rate",
              "test_pass_rate",
              "policy_precision",
              "policy_recall",
              "blocked_dangerous_action_rate",
              "human_override_rate",
              "post_change_regression_rate"
            ]
          },
          "expected_delta": { "type": "number" }
        }
      }
    },
    "regressions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "severity"],
        "properties": {
          "summary": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/non_empty_text"
          },
          "severity": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "clusters"],
      "properties": {
        "runner": { "enum": ["dsh-headless", "dsh-headless-docker", "injected"] },
        "clusters": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cluster_id", "category", "code", "member_count"],
            "properties": {
              "cluster_id": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              },
              "category": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              },
              "code": {
                "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
              },
              "member_count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
