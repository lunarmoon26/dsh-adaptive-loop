{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursive-dev-loop.dev/schemas/guardrail-decision.v1.schema.json",
  "title": "Recursive Development Loop guardrail policy decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "storage_version",
    "decision_id",
    "evaluated_at",
    "effect",
    "request_sha256",
    "policy_sha256",
    "policy_version",
    "secret_ruleset_version",
    "pii_ruleset_version",
    "evaluator",
    "matched_rules",
    "approval_ref",
    "approval_sha256",
    "request"
  ],
  "properties": {
    "$schema": {
      "const": "https://recursive-dev-loop.dev/schemas/guardrail-decision.v1.schema.json"
    },
    "storage_version": { "const": "1.0.0" },
    "decision_id": {
      "type": "string",
      "pattern": "^gdec-[a-z0-9][a-z0-9._-]+$",
      "maxLength": 100
    },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "effect": {
      "enum": ["allowed", "denied", "requires_human_approval"]
    },
    "request_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "policy_sha256": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256"
    },
    "policy_version": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/semver"
    },
    "secret_ruleset_version": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
    },
    "pii_ruleset_version": {
      "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
    },
    "evaluator": { "const": "rdl-deterministic-policy-v1" },
    "matched_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "effect", "summary"],
        "properties": {
          "id": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/identifier"
          },
          "effect": {
            "enum": ["allowed", "denied", "requires_human_approval"]
          },
          "summary": {
            "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/short_text"
          }
        }
      }
    },
    "approval_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/decision_id" }
      ]
    },
    "approval_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://recursive-dev-loop.dev/schemas/common.v1.schema.json#/$defs/sha256" }
      ]
    },
    "request": {
      "$ref": "https://recursive-dev-loop.dev/schemas/guardrail-action.v1.schema.json"
    }
  }
}
