# Local secrets for the docker-hosted harness.
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# .env is gitignored and must never be committed.
#
# dal passes through only the environment names listed in
# config/policy.v1.json docker_env_names (default: DEEPSEEK_API_KEY),
# from the host process environment first, then from this file.
#
# The tau-style e2e driver (pnpm benchmark:e2e) resolves each provider's
# credential by name (see benchmarks/tau-style-workflow/PROVIDERS.md) and
# passes exactly that one variable into the container; a missing key fails
# the batch before any model call.
DEEPSEEK_API_KEY=
# OpenAI (route openai, default model gpt-5.6-luna)
OPENAI_API_KEY=
# Anthropic (route anthropic, default model claude-sonnet-5)
ANTHROPIC_API_KEY=
# Z.ai / GLM (route zai, default model glm-5.2)
ZAI_API_KEY=
# Moonshot / Kimi (route moonshotai, default model kimi-k3)
MOONSHOT_API_KEY=
